const rows = [
  {pct: 28.3, label: 'Show me someone in this industry', top: true},
  {pct: 23.3, label: 'Give me a case study', top: true},
  {pct: 15.0, label: 'Show me a similar customer', top: true},
  {pct: 13.6, label: 'I need a quote for my deck'},
  {pct: 9.6, label: 'How do customers use this feature?'},
  {pct: 6.0, label: 'How do we compare to competitors?'},
];

export const DataScene: React.FC = () => {
  const frame = useCurrentFrame();

  const headerO = interpolate(frame, [0, 12], [0, 1], {extrapolateRight: 'clamp'});
